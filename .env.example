# Copy to .env and fill in. Never commit real keys.

# --- Option A: AI Studio (Gemini API) key — simplest ---
GEMINI_API_KEY=

# --- Option B: Vertex AI (set USE_VERTEX=1 and these) ---
USE_VERTEX=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Model to use
GEMINI_MODEL=gemini-2.5-flash

# --- Cloud Storage (optional): read SOP/scenarios from a bucket ---
GCS_BUCKET=
GCS_PREFIX=

# --- BigQuery (optional): log case outcomes for analysis ---
# Dataset must exist in GOOGLE_CLOUD_PROJECT; table 'cases' is auto-created.
BQ_DATASET=

# --- Firestore (optional): multi-device registry, users, RAG vectors ---
# Set USE_FIRESTORE=1 to use Firestore; otherwise a local .localstore/ JSON file is used.
USE_FIRESTORE=0
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)

# --- Secret Manager (optional): device credentials + integration API keys ---
USE_SECRET_MANAGER=0

# --- Embeddings model (Vertex AI) ---
EMBED_MODEL=text-embedding-004

# --- Seed admin (first run only) ---
AEGIS_ADMIN_EMAIL=admin@aegisops.demo
AEGIS_ADMIN_PASSWORD=admin12345

# --- Integrations (optional; can also be set in the Integrations page) ---
GITHUB_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
